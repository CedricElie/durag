flowchart TD
    %% Source Layer
    subgraph Sources ["1. Ingestion Sources"]
        E1[Gmail / M365 / IMAP Inbox]
        E2[Forwarded / BCC Emails]
        FS[Direct Upload / Shared Drive]
    end

    %% Email ETL Layer
    subgraph EmailETL ["2. Email Fetching & Preprocessing"]
        W[Ingestion Worker / Poller / n8n]
        Dedup{SHA-256 Hash Exists?}
        Meta[Extract Email Metadata:<br/>Sender, Date, Subject, Thread ID]
        Filter[Filter Allowed Types:<br/>.pdf, .docx, .xlsx]
    end

    %% Parsing & Chunking Layer
    subgraph Parsing ["3. Format-Specific Parsing"]
        Route{Document Type?}
        ParsePDF[LlamaParse / Docling / Unstructured<br/>Preserve layout & headers]
        ParseWord[Docx Parser<br/>Extract sections & body text]
        ParseExcel[Pandas / OpenPyXL<br/>Markdown tables + Sheet schemas]
        Chunker[Semantic & Structural Chunking]
    end

    %% Storage & Indexing Layer
    subgraph Storage ["4. Storage & Indexing"]
        Embed[Embedding Model<br/>e.g., text-embedding-3 / BGE]
        VDB[(Vector Store + BM25<br/>Qdrant / Milvus / pgvector)]
        RawStore[(Raw Document Store<br/>S3 / MinIO / Local FS)]
    end

    %% Query & Synthesis Layer
    subgraph Retrieval ["5. Query & Synthesis"]
        User([DevOps Engineer Query])
        HybSearch[Hybrid Retrieval<br/>Dense Vector + Sparse Keyword]
        Rerank[Cross-Encoder Reranker<br/>Cohere / BGE-Reranker]
        LLM[Agentic LLM / Synthesis Engine]
        Answer([Summary / Answer with Citations])
    end

    %% Connections
    E1 --> W
    E2 --> W
    FS --> Filter

    W --> Filter
    Filter --> Meta
    Meta --> Dedup

    Dedup -- Yes --> Skip[Skip / Log Duplicate]
    Dedup -- No --> RawStore
    Dedup -- No --> Route

    Route -- .pdf --> ParsePDF
    Route -- .docx --> ParseWord
    Route -- .xlsx --> ParseExcel

    ParsePDF --> Chunker
    ParseWord --> Chunker
    ParseExcel --> Chunker

    Chunker --> Embed
    Embed --> VDB
    Meta -. Attach metadata to chunks .-> VDB

    User --> HybSearch
    VDB --> HybSearch
    HybSearch --> Rerank
    Rerank --> LLM
    LLM --> Answer